/*
 * moutis_macros.dtsi
 *
 * SPDX-License-Identifier: MIT
 *
 * t_  = type text
 * b_  = backspace then type text (often for "adaptive key")
 * m_  = macro (performs commands/behaviors, incl. typing).
 * ak_ = type a letter as an adaptive key (consider the prior key).
 *
 */

     // &num_word 是 #binding-cells = <1>（要带层号），在 keymap 的单格里
     // 必须包一层补上参数 —— 与上游 moutis 的 m_numword 同一个套路。
     #define m_numword num_word l_num

     ZMK_MACRO(m_alpha,
        bindings =
            <&kp LANG2>,    // switch to Roman/Latin script (n_henk)
            <&to l_alpha>; // make alpha layer default
       )
     ZMK_MACRO(m_japan,
        bindings =
            <&kp LANG1>,    // switch to Japanese script (m_henk)
            <&to l_jp>;     // make Japanese layer default
       )

   ZMK_MACRO(SlAppy,        // "Sticky Layer App Switcher"
        wait-ms = <50>; tap-ms = <20>;
        bindings =
                    <&macro_press &kp RGUI>    // leave GUI down to keep menu up
                  , <&macro_tap &kp TAB>       // (use press for repeat)
                  , <&tog l_nav>               // to navigate the app menu
                  , <&macro_pause_for_release> // hold to keep menu up or for repeat ...
                  , <&tog l_nav>               // done navigating
                  , <&macro_tap &skapp LGUI>   // release other GUI after a timeout
                  , <&macro_release &kp RGUI>  // release the previous hold
                  ;
        )
    ZMK_MACRO(SlApBack,        // "Sticky Layer App Switcher Backwards"
        wait-ms = <50>; tap-ms = <20>;
        bindings =
                    <&macro_press &sk RGUI>     // leave GUI down to keep menu up
                  , <&macro_press &kp LSHFT>    //
                  , <&macro_tap &kp TAB>        // just tap for no repeat
                  , <&macro_pause_for_release>  // hold for repeat ...
                  , <&macro_release &kp LSHFT>  //
                  , <&macro_tap &skapp LGUI>    // release other GUI after a timeout
                  , <&macro_release &sk RGUI>   // now release the previous hold
                  ;
        )

    // ---------------------------------------------------------------------
    // Windows 组合键宏
    // ⚠️ 为什么必须写成宏：keymap 里每个 binding slot 只接受 **一个 cell**。
    //    这里的 thumb 位（HD_RH 等）就是一个 slot，塞 `&kp LCTRL BSLH`（2 个 cell）
    //    会把后面所有位置的 cell 数错位，编译报 DT_..._bindings_IDX_51_PH_FULL_NAME undeclared。
    //    用宏包起来 → 宏本身 #binding-cells = <0>，占 1 个 cell，位置就对齐了。
    //    （同样的道理适用于所有把多 cell 绑定放进单个 slot 的地方。）
    // ---------------------------------------------------------------------
    ZMK_MACRO(m_bsdel,   tap-ms = <20>; bindings = <&macro_press &kp LCTRL>, <&kp BSPC>,  <&macro_release &kp LCTRL>; )
    ZMK_MACRO(m_deldel,  tap-ms = <20>; bindings = <&macro_press &kp LCTRL>, <&kp DEL>,   <&macro_release &kp LCTRL>; )
    ZMK_MACRO(m_ctrlbslh,tap-ms = <20>; bindings = <&macro_press &kp LCTRL>, <&kp BSLH>,  <&macro_release &kp LCTRL>; )
    ZMK_MACRO(m_winclose,tap-ms=<20>; bindings = <&macro_press &kp LALT>,  <&kp F4>,    <&macro_release &kp LALT>; )
    ZMK_MACRO(m_taskmgr, tap-ms = <20>; bindings = <&macro_press &kp LCTRL &kp LSHFT>, <&kp ESC>, <&macro_release &kp LSHFT &kp LCTRL>; )
    ZMK_MACRO(m_redo,    tap-ms = <20>; bindings = <&macro_press &kp LCTRL>, <&kp Y>,    <&macro_release &kp LCTRL>; )
    ZMK_MACRO(m_save,    tap-ms = <20>; bindings = <&macro_press &kp LCTRL>, <&kp S>,    <&macro_release &kp LCTRL>; )
    ZMK_MACRO(m_quit,    tap-ms = <20>; bindings = <&macro_press &kp LCTRL>, <&kp Q>,    <&macro_release &kp LCTRL>; )
    ZMK_MACRO(m_new,     tap-ms = <20>; bindings = <&macro_press &kp LCTRL>, <&kp N>,    <&macro_release &kp LCTRL>; )
    ZMK_MACRO(m_close,   tap-ms = <20>; bindings = <&macro_press &kp LCTRL>, <&kp W>,    <&macro_release &kp LCTRL>; )
    ZMK_MACRO(m_open,    tap-ms = <20>; bindings = <&macro_press &kp LCTRL>, <&kp O>,    <&macro_release &kp LCTRL>; )
    ZMK_MACRO(m_selectall,tap-ms=<20>; bindings = <&macro_press &kp LCTRL>, <&kp A>,    <&macro_release &kp LCTRL>; )
    ZMK_MACRO(m_undo,    tap-ms = <20>; bindings = <&macro_press &kp LCTRL>, <&kp Z>,    <&macro_release &kp LCTRL>; )
    ZMK_MACRO(m_cut,     tap-ms = <20>; bindings = <&macro_press &kp LCTRL>, <&kp X>,    <&macro_release &kp LCTRL>; )
    ZMK_MACRO(m_copy,    tap-ms = <20>; bindings = <&macro_press &kp LCTRL>, <&kp C>,    <&macro_release &kp LCTRL>; )
    ZMK_MACRO(m_paste,   tap-ms = <20>; bindings = <&macro_press &kp LCTRL>, <&kp V>,    <&macro_release &kp LCTRL>; )
    ZMK_MACRO(m_find,    tap-ms = <20>; bindings = <&macro_press &kp LCTRL>, <&kp F>,    <&macro_release &kp LCTRL>; )
    ZMK_MACRO(m_pgback,  tap-ms = <20>; bindings = <&macro_press &kp LCTRL>, <&kp LBKT>, <&macro_release &kp LCTRL>; )
    ZMK_MACRO(m_pgfwd,   tap-ms = <20>; bindings = <&macro_press &kp LCTRL>, <&kp RBKT>, <&macro_release &kp LCTRL>; )
    ZMK_MACRO(m_docstart,tap-ms = <20>; bindings = <&macro_press &kp LCTRL>, <&kp HOME>, <&macro_release &kp LCTRL>; )
    ZMK_MACRO(m_docend,  tap-ms = <20>; bindings = <&macro_press &kp LCTRL>, <&kp END>,  <&macro_release &kp LCTRL>; )
    ZMK_MACRO(m_wordl,   tap-ms = <20>; bindings = <&macro_press &kp LCTRL>, <&kp LEFT>, <&macro_release &kp LCTRL>; )
    ZMK_MACRO(m_wordr,   tap-ms = <20>; bindings = <&macro_press &kp LCTRL>, <&kp RIGHT>,<&macro_release &kp LCTRL>; )
    ZMK_MACRO(m_paraup,  tap-ms = <20>; bindings = <&macro_press &kp LCTRL>, <&kp UP>,   <&macro_release &kp LCTRL>; )
    ZMK_MACRO(m_paradn,  tap-ms = <20>; bindings = <&macro_press &kp LCTRL>, <&kp DOWN>, <&macro_release &kp LCTRL>; )
    ZMK_MACRO(m_zoomin,  tap-ms = <20>; bindings = <&macro_press &kp LCTRL>, <&kp EQUAL>,<&macro_release &kp LCTRL>; )
    ZMK_MACRO(m_zoomout, tap-ms = <20>; bindings = <&macro_press &kp LCTRL>, <&kp MINUS>,<&macro_release &kp LCTRL>; )
    ZMK_MACRO(m_zoomrst, tap-ms = <20>; bindings = <&macro_press &kp LCTRL>, <&kp N0>,   <&macro_release &kp LCTRL>; )

    ZMK_MACRO(m_selword,
        tap-ms = <40>;
        // ⚠️ 宏的 bindings 是 phandle-array，每一个 phandle 只能带 **一个** cell。
        //    `&kp LCTRL LEFT` 是 2 个 cell，会被拆成两个 slot → 编译报
        //    DT_..._bindings_IDX_1_PH_FULL_NAME undeclared。
        //    修法与同文件里的 SlAppy 一致：显式 press/release 修饰键。
        bindings = <&macro_press   &kp LCTRL>
                 , <&kp LEFT>
                 , <&macro_release &kp LCTRL>
                 , <&macro_press   &kp LCTRL &kp LSHFT>
                 , <&kp RIGHT>
                 , <&macro_release &kp LSHFT &kp LCTRL>
                 ;
        )
        // 原为 Mac 的 ⌥← / ⇧⌥→（按词选中）；Windows 等价键是 Ctrl+← / Ctrl+Shift+→
    ZMK_MACRO(m_findsel,
        tap-ms = <40>;
        bindings = <&macro_press   &kp LCTRL &kp LSHFT>
                 , <&kp C>
                 , <&macro_release &kp LSHFT>
                 , <&kp F>
                 , <&kp V>
                 , <&macro_release &kp LCTRL>
                 , <&kp RETURN>
                 , <&kp F3>
                 ;
        )
        // 原为 Mac 的 ⌘C / ⌘F / ⌘V / ⌘G（查找下一个）
        // Windows: Ctrl+Shift+C 复制 / Ctrl+F 查找 / Ctrl+V 粘贴 / Enter / F3 下一个
        // （Windows Terminal 用 Ctrl+Shift+C 复制；用 Ctrl+C 会变成中断信号）

    ZMK_MACRO(pairDquo,
        wait-ms = <50>; // need to slow this down for some systems.
        bindings = <&kp DQT &kp DQT &kp LEFT>
                ;
        )
        // 原为 Mac 的 ⌥[ / ⇧⌥[ 产生弯引号 “ ”；Windows 无原生键位，
        // 已退化为两个直引号 ""（光标停在中间）。若要 “ ” 见 moutis_combos.dtsi 文末"待你决定"。
    ZMK_MACRO(pairSquo,
        wait-ms = <50>; // need to slow this down for some systems.
        bindings = <&kp SQT &kp SQT &kp LEFT>
                ;
        )
        // 原为 Mac 的 ⌥] / ⇧⌥] 产生弯引号 ‘ ’；已退化为两个直引号 ''
    ZMK_MACRO(pairLtGt,
        wait-ms = <50>; // need to slow this down for some systems.
        bindings = <&kp LT &kp GT &kp LEFT>
                ;
        )
    ZMK_MACRO(pairPar,
        wait-ms = <50>; // need to slow this down for some systems.
        bindings = <&kp LPAR &kp RPAR &kp LEFT>
                ;
        )
    ZMK_MACRO(pairBrc,
        wait-ms = <50>; // need to slow this down for some systems.
        bindings = <&kp LBRC &kp RBRC &kp LEFT>
                ;
        )
    ZMK_MACRO(pairBkt,
        wait-ms = <50>; // need to slow this down for some systems.
        bindings = <&kp LBKT &kp RBKT &kp LEFT>
                ;
        )

    ZMK_MACRO(sl_dot,
        wait-ms = <50>; // need to slow this down for some systems.
        bindings = <&macro_tap &kp DOT>
                , <&sl l_akDot>
                ;
        )

    ZMK_MACRO(t_Qu,
        tap-ms = <40>;
        bindings = <&ak_Q>
                , <&macro_release &kp LSHFT>
                , <&macro_release &kp RSHFT>
                , <&macro_tap &kp U>
                ;
        )
    ZMK_MACRO(t_Semi,
        tap-ms = <40>;
        bindings = <&macro_release &kp LSHFT>
                , <&macro_tap &kp SEMICOLON>
                ;
        )
    // ⚠️ 已删除 7 个 macOS 死键宏（t_Eaccent / t_Egrave / t_Eacute / t_Omacron /
    //    t_Aring / t_Uumlaut / t_Cedille）。它们依赖 Mac 的 Option 死键
    //    （&kp LA(E) &kp E → é），Windows 上只会输出乱码。
    //    对应的 combo 已改为直接输出单个字母（见 moutis_combos.dtsi）。

    ZMK_MACRO(t_pg,
        tap-ms = <40>;
        bindings = <&kp P &kp G>;
        )
    ZMK_MACRO(t_dotcom,
        wait-ms = <50>; // need to slow this down for some systems.
        bindings = <&kp C &kp O &kp M>
                ;
        )
    ZMK_MACRO(t_dotedu,
        wait-ms = <50>; // need to slow this down for some systems.
        bindings = <&kp E &kp D &kp U>
                ;
        )
    ZMK_MACRO(t_dotorg,
        wait-ms = <50>; // need to slow this down for some systems.
        bindings = <&kp O &kp R &kp G>
                ;
        )

    ZMK_MACRO(t_Japan,
        tap-ms = <40>;
        bindings = <&macro_press &kp LSHFT>
                    , <&macro_tap &kp J>
                    , <&macro_release &kp LSHFT>
                    , <&macro_release &kp RSHFT>
                    , <&macro_tap &kp A &kp P &kp A &kp N &kp SPACE>
                ;
        )
    ZMK_MACRO(t_Japanese,
        tap-ms = <40>;
        bindings = <&macro_press &kp LSHFT>
                    , <&macro_tap &kp J>
                    , <&macro_release &kp LSHFT>
                    , <&macro_release &kp RSHFT>
                    , <&macro_tap &kp A &kp P &kp A &kp N &kp E &kp S &kp E &kp SPACE>
                ;
        )

    ZMK_MACRO(t_nn, // from the Japanese layer, L=ん
        tap-ms = <40>;
        bindings = <&macro_tap &kp N>
                , <&macro_tap &kp N>
                ;
        )

#ifdef H_DIGRAPH_COMBOS
